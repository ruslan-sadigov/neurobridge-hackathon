# --- LLM (only hard external dependency): anthropic | gemini ---
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_EXTRACTION_MODEL=claude-sonnet-5-5
LLM_CLASSIFICATION_MODEL=claude-haiku-5-5

# Gemini (free tier from https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_MIN_INTERVAL_S=6

# --- Embeddings: "local" (sentence-transformers) or "hash" (offline test stub) ---
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3

# --- CORS: comma-separated frontend origins ---
CORS_ORIGINS=http://localhost:3000

# --- Persistence: sqlite for dev, postgres for demo ---
DATABASE_URL=sqlite:///./bidbridge.db
STORAGE_DIR=./storage

# --- OCR fallback for image-only pages ---
OCR_ENABLED=true
OCR_LANGS=eng+aze
