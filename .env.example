# --- LLM (only hard external dependency) ---
ANTHROPIC_API_KEY=
LLM_EXTRACTION_MODEL=claude-sonnet-5-5
LLM_CLASSIFICATION_MODEL=claude-haiku-5-5

# --- Embeddings: "local" (sentence-transformers) or "hash" (offline test stub) ---
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=BAAI/bge-m3

# --- Persistence: sqlite for dev, postgres for demo ---
DATABASE_URL=sqlite:///./bidbridge.db
STORAGE_DIR=./storage

# --- OCR fallback for image-only pages ---
OCR_ENABLED=true
OCR_LANGS=eng+aze
